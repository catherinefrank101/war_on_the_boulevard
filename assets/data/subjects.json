---
layout: null
---
{%- assign items = site.data.posters -%}
{%- assign all_subjects = "" | split: "," -%}

{%- for item in items -%}
  {%- if item.subject and item.subject != "" -%}
    {%- assign poster_subjects = item.subject | split: ";" -%}
    {%- for s in poster_subjects -%}
      {%- assign all_subjects = all_subjects | push: s | strip -%}
    {%- endfor -%}
  {%- endif -%}
{%- endfor -%}

{%- assign unique_subjects = all_subjects | uniq -%}
{%- assign subject_counts = "" | split: "," -%}

{%- for u in unique_subjects -%}
  {%- assign count = all_subjects | where: "", u | size -%}
  {%- capture entry -%}{{ count | prepend: "00000" | slice: -5, 5 }}:{{ u }}{%- endcapture -%}
  {%- assign subject_counts = subject_counts | push: entry -%}
{%- endfor -%}

{%- assign sorted_subjects = subject_counts | sort | reverse | slice: 0, 150 -%}

{
  "subjects": [
    {%- for entry in sorted_subjects -%}
      {%- assign parts = entry | split: ":" -%}
      {
        "subject": {{ parts[1] | jsonify }},
        "count": {{ parts[0] | plus: 0 }},
        "link": {{ parts[1] | url_param_escape | prepend: '/browse.html#' | absolute_url | jsonify }}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
